{
  "deployment_profile": "single_tenant",
  "env": [
    {
      "key": "PATH",
      "value": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    },
    {
      "key": "MODE",
      "value": "dev"
    },
    {
      "key": "EXTRA",
      "value": "1"
    }
  ],
  "external_mount_policy": "strict",
  "image": {
    "Oci": {
      "reference": "alpine:3.20",
      "root_disk": {
        "kind": "managed",
        "size_mib": 4096
      }
    }
  },
  "init": null,
  "labels": {
    "studio.network": "internet"
  },
  "lifecycle": {
    "ephemeral": false,
    "idle_timeout_secs": null,
    "max_duration_secs": null
  },
  "manifest_digest": "sha256:45e09956dc667c5eff3583c9d94830261fb1ca0be10a0a7db36266edf5de9e1d",
  "mounts": [
    {
      "follow_root_symlinks": false,
      "guest": "/workspaces/project",
      "host": "/home/me/project",
      "host_permissions": "private",
      "options": {
        "nodev": false,
        "noexec": false,
        "nosuid": false,
        "readonly": false
      },
      "quota_mib": null,
      "stat_virtualization": "strict",
      "type": "Bind"
    }
  ],
  "name": "probe",
  "network": {
    "dns": {
      "nameservers": [],
      "query_timeout_ms": 5000,
      "rebind_protection": true
    },
    "enabled": true,
    "http": {
      "deny_response": true,
      "deny_response_format": "json"
    },
    "interface": {},
    "max_connections": null,
    "nat64_prefixes": [
      "64:ff9b::/96"
    ],
    "policy": {
      "default_egress": "deny",
      "default_ingress": "allow",
      "rules": [
        {
          "action": "allow",
          "destination": {
            "group": "host"
          },
          "direction": "egress",
          "ports": [
            {
              "end": 53,
              "start": 53
            }
          ],
          "protocols": [
            "udp"
          ]
        },
        {
          "action": "allow",
          "destination": {
            "group": "host"
          },
          "direction": "egress",
          "ports": [
            {
              "end": 53,
              "start": 53
            }
          ],
          "protocols": [
            "tcp"
          ]
        },
        {
          "action": "allow",
          "destination": {
            "group": "public"
          },
          "direction": "egress",
          "ports": [],
          "protocols": []
        }
      ]
    },
    "ports": [
      {
        "guest_port": 80,
        "host_bind": "127.0.0.1",
        "host_port": 18080,
        "protocol": "tcp"
      }
    ],
    "secrets": {
      "secrets": [
        {
          "allowed_hosts": [
            {
              "exact": "api.github.com"
            }
          ],
          "env_var": "TOKEN",
          "passthrough_hosts": [],
          "placeholder": "$MSB_TOKEN",
          "require_tls_identity": true,
          "source": null,
          "substitution": {
            "body": false,
            "headers": true,
            "query": false
          },
          "value": "token-value"
        },
        {
          "allowed_hosts": [
            {
              "exact": "x.com"
            }
          ],
          "env_var": "INLINE",
          "passthrough_hosts": [],
          "placeholder": "$MSB_INLINE",
          "require_tls_identity": true,
          "substitution": {
            "body": false,
            "headers": true,
            "query": false
          },
          "value": "plain"
        }
      ],
      "violation_action": "block-and-log"
    },
    "strict": true,
    "tls": {
      "block_quic_on_intercept": true,
      "bypass": [],
      "cache": {
        "capacity": 1000,
        "validity_hours": 24
      },
      "enabled": true,
      "intercept_ca": {
        "cert_path": null,
        "key_path": null
      },
      "intercepted_ports": [
        443
      ],
      "scoped_upstream_ca_cert": [],
      "scoped_verify_upstream": [],
      "upstream_ca_cert": [],
      "verify_upstream": true
    },
    "trust_host_cas": false
  },
  "patches": [],
  "pull_policy": "IfMissing",
  "resources": {
    "cpus": 2,
    "max_cpus": 2,
    "max_memory_mib": 1024,
    "memory_mib": 1024
  },
  "rlimits": [],
  "runtime": {
    "cmd": [
      "/bin/sh"
    ],
    "disable_metrics_sample": false,
    "entrypoint": null,
    "hostname": null,
    "log_level": null,
    "metrics_sample_interval_ms": 1000,
    "scripts": {},
    "shell": "/bin/sh",
    "user": null,
    "workdir": "/workspaces/project"
  },
  "security_profile": "default"
}
